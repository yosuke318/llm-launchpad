# terraform.tfvars にコピーして使う(terraform.tfvars は .gitignore 済み)

region = "ap-northeast-1"
# aws_profile = "default"

# 動かすモデル(catalog/models.yaml のキー)。必要VRAMを見積もり、収まるインスタンス型を自動で選ぶ
model = "qwen3:8b"

# コンテキスト長。長いほどKVキャッシュが増え、大きいインスタンス型が選ばれる
# context_length = 8192

# KVキャッシュの型。q8_0 / q4_0 にすると必要VRAMが減る(精度は少し落ちる)
# kv_cache_type = "f16"

# 重みとKVキャッシュのほかに見込む余裕(GiB)
# vram_overhead_gib = 1.5

# インスタンス型を手で指定する場合(catalog/instance_types.yaml にある型)。収まらない場合は警告を出す
# instance_type = "g5.xlarge"

# spot: スポット(中断されると停止し、在庫が戻ると再開する) / on-demand: オンデマンド
# purchase_option = "spot"

# 起動するAZ。未指定ならインスタンス型を提供しているAZから選ぶ
# availability_zone = "ap-northeast-1a"

# ルートボリュームの大きさ(GiB)。未指定なら AMI + モデルの配布サイズの2倍 + 10 GiB(ebs では AMI + 10 GiB)
# root_volume_size_gib = 200

# ルートボリュームの速さ。スループット(MiB/s)は IOPS x 0.25 まで。125 MiB/s を超える分は動かしている間だけ料金がかかる
# root_volume_throughput = 1000
# root_volume_iops       = 4000

# 自動停止。Ollama へのリクエストが idle_stop_minutes 分なければ止め、起動から max_lifetime_hours 時間で止める(0 で止めない)
# idle_stop_minutes  = 30
# max_lifetime_hours = 8

# 入れる Ollama のバージョン。未指定なら最新
# ollama_version = "0.12.6"

# 未指定なら terraform workspace 名を環境IDとして使う
# env_id = "qwen-test"

# ssm: インバウンドを開けず、SSMポートフォワードで接続する(推奨)
# direct: allowed_cidrs から Ollama API(11434)に直接接続する
access_mode = "ssm"

# direct のときだけ使う。空なら実行したマシンのグローバルIP(/32)を自動で使う
# allowed_cidrs = ["203.0.113.10/32"]

# vpc_cidr = "10.42.0.0/16"
# az_count = 3

# モデルの置き場所。s3_cache: S3 からコピーし、なければ取得して S3 に保存する(先に model-store でバケットを作る)
# ebs: model-store で作った EBS ボリュームを付ける / download: 毎回 Ollama library から取得する
# model_storage = "s3_cache"

# s3_cache のバケット名。未指定なら model-store と同じ規則の名前(llm-launchpad-models-<アカウントID>-<リージョン>)
# model_bucket_name = "my-models-bucket"

# ebs で付けるボリュームの名前(model-store の model_volumes のキー)
# model_volume_name = "default"

# extra_tags = {
#   Owner = "your-name"
# }
