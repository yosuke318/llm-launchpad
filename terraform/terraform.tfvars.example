# terraform.tfvars にコピーして使う(terraform.tfvars は .gitignore 済み)

region = "ap-northeast-1"
# aws_profile = "default"

# 動かすモデル(catalog/models.yaml のキー)。必要VRAMを見積もり、収まるインスタンス型を自動で選ぶ
model = "qwen3:8b"

# コンテキスト長。長いほどKVキャッシュが増え、大きいインスタンス型が選ばれる
# context_length = 8192

# KVキャッシュの型。q8_0 / q4_0 にすると必要VRAMが減る(精度は少し落ちる)
# kv_cache_type = "f16"

# 重みとKVキャッシュのほかに見込む余裕(GiB)
# vram_overhead_gib = 1.5

# インスタンス型を手で指定する場合(catalog/instance_types.yaml にある型)。収まらない場合は警告を出す
# instance_type = "g5.xlarge"

# 未指定なら terraform workspace 名を環境IDとして使う
# env_id = "qwen-test"

# ssm: インバウンドを開けず、SSMポートフォワードで接続する(推奨)
# direct: allowed_cidrs から Ollama API(11434)に直接接続する
access_mode = "ssm"

# direct のときだけ使う。空なら実行したマシンのグローバルIP(/32)を自動で使う
# allowed_cidrs = ["203.0.113.10/32"]

# vpc_cidr = "10.42.0.0/16"
# az_count = 3

# モデル置き場のS3バケット(YOSUKE-172 で作成)。指定するとインスタンスロールに読み取り権限を付ける
# model_bucket_name = "llm-launchpad-models-xxxxxxxx"

# extra_tags = {
#   Owner = "your-name"
# }
