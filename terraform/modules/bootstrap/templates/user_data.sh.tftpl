#!/bin/bash
# GPUインスタンスの初回起動時に cloud-init が root で実行する。
# Ollama を入れてモデルを取得し、段階ごとの状態を SSM Parameter Store(${status_parameter})に書く。
# -E は、関数(lp や stage)の中で失敗したときにも ERR トラップを動かすため
set -Eeuo pipefail

LOG_FILE=/var/log/llm-launchpad-bootstrap.log
exec > >(tee -a "$LOG_FILE") 2>&1

export LAUNCHPAD_REGION="${region}"
export LAUNCHPAD_STATUS_PARAMETER="${status_parameter}"
export LAUNCHPAD_STATE_FILE=/var/lib/llm-launchpad/status.json
export OLLAMA_URL="http://127.0.0.1:${ollama_port}"
export LAUNCHPAD_ENGINE="${engine}"
# cloud-init の実行中は HOME が無いことがある。AWS CLI の設定ファイルの置き場所に使う
export HOME=/root

MODELS_DIR="${models_dir}"

mkdir -p /opt/llm-launchpad /var/lib/llm-launchpad
# 推論エンジン。あとから SSM の send-command で動かす launchpad.py(計測やアイドル停止)が読む
echo "${engine}" > /var/lib/llm-launchpad/engine
cat > /opt/llm-launchpad/launchpad.py <<'PY'
${launchpad_py}
PY

lp() {
  python3 /opt/llm-launchpad/launchpad.py "$@"
}

current_stage=instance_started

# 失敗したら、止まった段階・行番号・ログの場所を書く
on_error() {
  # Hugging Face からの取得の進み具合を書いていたら、失敗を上書きしないよう先に止める
  if [ -n "$${TRACK_PID:-}" ]; then
    kill "$TRACK_PID" 2> /dev/null || true
  fi
  lp status "$current_stage" --state failed --error "line $1 exited with $2" --log "$LOG_FILE" || true
}
trap 'on_error $LINENO $?' ERR

stage() {
  current_stage=$1
  lp status "$1"
}

# 状態を書くのに AWS CLI を使う。Deep Learning Base AMI には入っているが、念のため確かめる
if ! command -v aws > /dev/null; then
  snap install aws-cli --classic
fi

stage instance_started
%{ if idle_stop_minutes > 0 ~}

# アイドル停止: 5分ごとに、Ollama へのリクエストが ${idle_stop_minutes} 分なければインスタンスを止める。
# 起動処理の途中では止めない(止まったまま進まない場合は、最大稼働時間で止まる)
cat > /etc/systemd/system/llm-launchpad-idle-stop.service <<'UNIT'
[Unit]
Description=Stop this instance when Ollama has been idle for ${idle_stop_minutes} minutes

[Service]
Type=oneshot
Environment="LAUNCHPAD_REGION=${region}"
Environment="LAUNCHPAD_STATUS_PARAMETER=${status_parameter}"
Environment="LAUNCHPAD_STATE_FILE=/var/lib/llm-launchpad/status.json"
Environment="HOME=/root"
ExecStart=/usr/bin/python3 /opt/llm-launchpad/launchpad.py idle-check --minutes ${idle_stop_minutes}
UNIT
cat > /etc/systemd/system/llm-launchpad-idle-stop.timer <<'UNIT'
[Unit]
Description=Check every 5 minutes whether Ollama is idle

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now llm-launchpad-idle-stop.timer
%{ endif ~}

stage installing_ollama
%{ if engine == "vllm" ~}
# vLLM は Docker の公式イメージ(vllm/vllm-openai)で動かす。GPU を使うので NVIDIA Container Toolkit が要る
# (Deep Learning Base AMI には入っている)。画面では「推論エンジンの導入」の段階として出る
if ! command -v docker > /dev/null; then
  apt-get update -q
  apt-get install -y -q docker.io
  systemctl enable --now docker
fi
if ! docker info 2> /dev/null | grep -qi nvidia && command -v nvidia-ctk > /dev/null; then
  nvidia-ctk runtime configure --runtime=docker
  systemctl restart docker
fi
if ! docker info 2> /dev/null | grep -qi nvidia; then
  echo "llm-launchpad: Docker から GPU を使えません(NVIDIA Container Toolkit がありません)"
  false
fi
docker pull --quiet "${vllm_image}"
%{ else ~}
%{ if offline ~}
# 閉じたネットワークでは ollama.com に出られないため、バケットに置いたリリースファイルから
# install.sh と同じ形で入れる(/usr/local に展開し、ollama ユーザーと systemd のサービスを作る)
aws s3 cp "s3://${install_bucket}/${ollama_install_key}" /tmp/ollama-linux-amd64.tar.zst --region "${region}" --only-show-errors
rm -rf /usr/local/lib/ollama
tar --zstd -xf /tmp/ollama-linux-amd64.tar.zst -C /usr/local
rm -f /tmp/ollama-linux-amd64.tar.zst
if ! id ollama > /dev/null 2>&1; then
  useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
fi
for group in render video; do
  if getent group "$group" > /dev/null; then
    usermod -a -G "$group" ollama
  fi
done
cat > /etc/systemd/system/ollama.service <<'UNIT'
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
UNIT
%{ else ~}
%{ if ollama_version == "" ~}
curl -fsSL https://ollama.com/install.sh | sh
%{ else ~}
curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION="${ollama_version}" sh
%{ endif ~}
%{ endif ~}

%{ endif ~}
%{ if open_webui ~}
# Open WebUI のイメージは大きい(数 GB)ので、モデルの用意と並べて取得しておく
if ! command -v docker > /dev/null; then
  apt-get update -q
  apt-get install -y -q docker.io
  systemctl enable --now docker
fi
docker pull --quiet "${open_webui_image}" > /var/log/llm-launchpad-open-webui-pull.log 2>&1 &
OPEN_WEBUI_PULL_PID=$!

%{ endif ~}
%{ if engine == "vllm" ~}
# モデルを Hugging Face から取得する(model_storage = download)。重みはルートボリュームのキャッシュに置く
stage preparing_storage
mkdir -p "${hf_cache_dir}"

stage pulling_model
%{ if hf_token_parameter != "" ~}
# gated のモデルのためのトークン。tfvars や user data には置かず、SSM パラメータ(SecureString)から読む
HF_TOKEN="$(aws ssm get-parameter --name "${hf_token_parameter}" --with-decryption --region "${region}" --query Parameter.Value --output text)"
export HF_TOKEN
%{ endif ~}
# 取得の進み具合(キャッシュの大きさ / 重みの大きさ)を、取得している間だけ書く
lp track-download "${hf_cache_dir}" ${vllm_weights_bytes} &
TRACK_PID=$!
docker run --rm -v "${hf_cache_dir}:/root/.cache/huggingface" %{ if hf_token_parameter != "" }-e HF_TOKEN %{ endif }\
  --entrypoint python3 "${vllm_image}" -c \
  "from huggingface_hub import snapshot_download; snapshot_download('${vllm_hf_repo}', allow_patterns=['*.json', '*.safetensors', '*.model', '*.txt', '*.jinja', 'tokenizer*'])"
kill "$TRACK_PID" 2> /dev/null || true
unset HF_TOKEN

# 取得したキャッシュだけで動かす(HF_HUB_OFFLINE)。Ollama と同じポートで OpenAI 互換 API を出すので、
# ポートフォワードや WebUI の中継はそのまま使える。served-model-name に Ollama のタグも入れ、同じ名前で呼べるようにする
docker rm -f vllm > /dev/null 2>&1 || true
docker run -d --name vllm --restart always --gpus all --ipc=host --network host \
  -v "${hf_cache_dir}:/root/.cache/huggingface" \
  -e HF_HUB_OFFLINE=1 \
  "${vllm_image}" \
  --model "${vllm_hf_repo}" \
  --served-model-name "${model}" "${vllm_hf_repo}" \
  --host ${ollama_host} \
  --port ${ollama_port} \
  --max-model-len ${context_length} \
  --gpu-memory-utilization 0.9 \
  --tensor-parallel-size ${vllm_tp} \
  --dtype ${vllm_dtype}

# GPU への読み込みと CUDA グラフの用意で数分かかる
stage verifying
lp wait-server --timeout 1800
lp verify "${model}"
%{ else ~}
# モデルの置き場所を用意する(model_storage = ${model_storage})
stage preparing_storage
%{ if model_storage == "ebs" ~}
lp mount-ebs "${volume_id}" "${mount_point}"
%{ endif ~}
# Ollama は起動時に ~/.ollama に鍵(id_ed25519)を作る。root の mkdir -p で .ollama を先に作ると root の
# 持ち物になり、Ollama が permission denied で起動できなくなるため、ollama ユーザーの持ち物として作る
install -d -o ollama -g ollama /usr/share/ollama/.ollama
mkdir -p "$MODELS_DIR"
%{ if model_storage == "s3_cache" ~}
# 大きいファイルのコピーを速くする(AWS CLI v2 の CRT 転送クライアント)
aws configure set default.s3.preferred_transfer_client crt
lp restore-s3 "${model}" "${bucket}" "$MODELS_DIR"%{ if offline } --offline%{ endif }
%{ endif ~}
chown -R ollama:ollama "$MODELS_DIR"

# 見積もりと同じ条件で動かす(コンテキスト長、KVキャッシュの型、同時リクエスト数 1)
mkdir -p /etc/systemd/system/ollama.service.d
cat > /etc/systemd/system/ollama.service.d/llm-launchpad.conf <<'CONF'
[Service]
Environment="OLLAMA_MODELS=${models_dir}"
Environment="OLLAMA_HOST=${ollama_host}:${ollama_port}"
Environment="OLLAMA_CONTEXT_LENGTH=${context_length}"
Environment="OLLAMA_KV_CACHE_TYPE=${kv_cache_type}"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_KEEP_ALIVE=-1"
%{ if kv_cache_type != "f16" ~}
# KVキャッシュの量子化には Flash Attention が要る
Environment="OLLAMA_FLASH_ATTENTION=1"
%{ endif ~}
CONF
systemctl daemon-reload
systemctl enable ollama
systemctl restart ollama
lp wait-server

stage pulling_model
%{ if offline ~}
# 閉じたネットワークでは Ollama library に問い合わせられないため、手元にあるかだけを確かめる
lp check-local "${model}"
%{ else ~}
# S3 や EBS からコピー済みなら、Ollama は manifest を確かめるだけで、blob は取り直さない
lp pull "${model}"
%{ endif ~}

stage verifying
lp verify "${model}"
%{ endif ~}
%{ if open_webui ~}

# Open WebUI を、Ollama と同じく 127.0.0.1 だけで待ち受けて動かす。セキュリティグループは開けず、
# SSM のポートフォワード(open_webui_port_forward_command)でだけ使える。SSM の権限がある人だけが届くので、ログインは切る
wait "$OPEN_WEBUI_PULL_PID"
docker rm -f open-webui > /dev/null 2>&1 || true
docker run -d --name open-webui --restart always --network host \
  -v open-webui:/app/backend/data \
%{ if engine == "vllm" ~}
  -e ENABLE_OLLAMA_API=False \
  -e OPENAI_API_BASE_URL="http://127.0.0.1:${ollama_port}/v1" \
  -e OPENAI_API_KEY=none \
%{ else ~}
  -e OLLAMA_BASE_URL="http://127.0.0.1:${ollama_port}" \
%{ endif ~}
  -e HOST=127.0.0.1 \
  -e PORT=${open_webui_port} \
  -e WEBUI_AUTH=False \
  "${open_webui_image}"
# 初回は埋め込みモデルの取得などで数分かかる。10分待っても応えなければ失敗にする
for _ in $(seq 1 120); do
  if curl -fsS "http://127.0.0.1:${open_webui_port}/health" > /dev/null 2>&1; then
    break
  fi
  sleep 5
done
curl -fsS "http://127.0.0.1:${open_webui_port}/health" > /dev/null
echo "llm-launchpad: Open WebUI is ready on 127.0.0.1:${open_webui_port}"
%{ endif ~}

lp status ready --state ready
echo "llm-launchpad: ${model} is ready"
%{ if model_storage == "s3_cache" && !offline ~}

# 使える状態にしてから、S3 になかったモデルを保存する(次の起動から S3 からコピーできる)
current_stage=ready
lp save-s3 "${model}" "${bucket}" "$MODELS_DIR"
%{ endif ~}
